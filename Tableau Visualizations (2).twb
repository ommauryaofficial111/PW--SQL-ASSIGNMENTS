      <column caption='Cumulative_Sales' datatype='real' name='[Calculation_0888446513401856]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='RUNNING_SUM(SUM([Sales]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Profit Status' datatype='string' name='[Calculation_0888446515941377]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Profit] &lt; 0 THEN &quot;Loss-making&quot; &#13;&#10;ELSE &quot;Profitable&quot; &#13;&#10;END' />
      </column>
      <column caption='Profit Margin' datatype='real' name='[Calculation_0888446521176066]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Profit]) / SUM([Sales])' />
