  <worksheets>
    <worksheet name='Q1.'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontcolor='#000000' fontname='Benton Sans Book'>Task 1 :- Category Performance Analysis </run>
            <run>Æ&#10;&#10;</run>
            <run bold='true' fontcolor='#000000' fontname='Benton Sans Book'>Business Need :-</run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000' fontname='Benton Sans Book'>Management wants to know which product categories generate the highest revenue. </run>
            <run>Æ&#10;&#10;</run>
            <run fontcolor='#000000' fontname='Benton Sans Book'>Task :- Create a visualization to compare total Sales by Category and identify the top-performing category.</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Dataset (Retail_dataset)' name='federated.0umnjfh063euht12lo98d0nygfmb' />
